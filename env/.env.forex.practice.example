MARKET=FOREX
FOREX_ENVIRONMENT=practice
FOREX_ENABLED=true
FOREX_PROVIDER=oanda
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_STREAM_STARTUP_TIMEOUT_SECONDS=60
FOREX_EXECUTION_ENABLED=false
FOREX_KILL_SWITCH=false
FOREX_DB_SCHEMA=forex
FOREX_CONFIG_ROOT=config/forex
FOREX_ARTIFACT_ROOT=artifacts/forex
FOREX_LOG_ROOT=logs/forex
FOREX_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP,EUR_JPY,GBP_JPY
FOREX_PAPER_ACCOUNT_EQUITY=100000
FOREX_DAILY_LOSS_LIMIT_FRACTION=0.02
FOREX_MAX_MARGIN_UTILIZATION=0.50

# --- Trade horizons -----------------------------------------------------------
# Intraday/swing pass plus an additive 5m SCALP pass on a disjoint timeframe set
# with tighter risk/spread limits. Set FOREX_SCALP_ENABLED=false to run intraday
# only (byte-identical to pre-scalp behaviour). 5m grains stay SHADOW until
# scripts/validate_forex_strategies.py grants OOS eligibility.
FOREX_INTRADAY_TIMEFRAMES=15m,30m,1h,4h
FOREX_SCALP_ENABLED=true
FOREX_SCALP_TIMEFRAMES=5m
FOREX_SCALP_RISK_PER_TRADE=0.0025
FOREX_SCALP_MAX_POSITIONS=3
FOREX_SCALP_MAX_SPREAD_PIPS=2.0
