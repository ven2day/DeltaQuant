[Unit]
Description=DeltaQuant offline ML challenger trainer
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=deltaquant
WorkingDirectory=/opt/deltaquant
EnvironmentFile=/opt/deltaquant/env/.env.common
Environment=MARKET=FOREX
Environment=FOREX_ENVIRONMENT=practice
EnvironmentFile=/opt/deltaquant/env/.env.forex.practice
ExecStart=/usr/local/bin/uv run deltaquant-ml-trainer --market FOREX
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
