[Unit]
Description=DeltaQuant NSE worker (Dhan)
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaquant
WorkingDirectory=/opt/deltaquant
Environment=MARKET=NSE
EnvironmentFile=/opt/deltaquant/env/.env.common
EnvironmentFile=/opt/deltaquant/env/.env.nse
ExecStart=/usr/local/bin/uv run deltaquant-nse
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

