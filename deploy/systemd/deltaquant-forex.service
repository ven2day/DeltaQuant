[Unit]
Description=DeltaQuant Forex worker (OANDA Practice)
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaquant
WorkingDirectory=/opt/deltaquant
Environment=MARKET=FOREX
Environment=FOREX_ENVIRONMENT=practice
EnvironmentFile=/opt/deltaquant/env/.env.common
EnvironmentFile=/opt/deltaquant/env/.env.forex.practice
ExecStart=/usr/local/bin/uv run deltaquant-forex
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

