[Unit]
Description=DeltaQuant Crypto worker
After=network-online.target postgresql.service

[Service]
Type=simple
User=deltaquant
WorkingDirectory=/opt/deltaquant
Environment=MARKET=CRYPTO
EnvironmentFile=/opt/deltaquant/env/.env.common
EnvironmentFile=/opt/deltaquant/env/.env.crypto
ExecStart=/usr/local/bin/uv run deltaquant-crypto
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
