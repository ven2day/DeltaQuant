[Unit]
Description=DeltaQuant aggregate read-only API
After=network-online.target

[Service]
Type=simple
User=deltaquant
WorkingDirectory=/opt/deltaquant
EnvironmentFile=/opt/deltaquant/env/.env.common
ExecStart=/usr/local/bin/uv run --extra web deltaquant-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
