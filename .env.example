# ===========================================
# Agentic Paper Trading System - Environment
# ===========================================

# -----------------------------------------
# LLM Provider - Groq (FREE tier available)
# Get API key: https://console.groq.com/keys
# -----------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------
# Broker API - DhanHQ (Sandbox for paper trading)
# 1. Create account: https://dhan.co
# 2. Developer Portal: https://developer.dhan.co
# 3. Sandbox Token: https://developer.dhan.co (use sandbox URL below)
# 4. Production Token: https://web.dhan.co (use api.dhan.co URL)
# -----------------------------------------
DHAN_CLIENT_ID=your_dhan_client_id
# Manually-generated token (expires in 24h). Leave blank if using PIN+TOTP auto-login
# below — get_valid_access_token() (src/market/dhan_auth.py) prefers a cached
# auto-generated token and only falls back to this static one.
DHAN_ACCESS_TOKEN=your_dhan_access_token
# Use sandbox.dhan.co for sandbox tokens, api.dhan.co for production
DHAN_BASE_URL=https://sandbox.dhan.co/v2

# Automatic login (recommended): generates + caches a fresh access token via your
# PIN and TOTP secret instead of pasting a manually-generated token every 24h.
# DHAN_PIN=your_dhan_pin
# DHAN_TOTP_SECRET=your_dhan_totp_secret
DHAN_TOKEN_CACHE_FILE=.dhan_token_cache.json
# DHAN_API_KEY=your_dhan_api_key
# DHAN_API_SECRET=your_dhan_api_secret
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_FEED_URL=wss://api-feed.dhan.co
DHAN_EXCHANGE_SEGMENT=NSE_EQ
DHAN_PRODUCT_TYPE=CNC
DHAN_INSTRUMENT=EQUITY
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv

# Resolve NSE equity security IDs by fetching DhanHQ's public instrument master
# at startup, instead of a small hardcoded ~20-symbol watchlist — needed for any
# symbol in a custom STOCK_UNIVERSE_CSV_PATH to get live Dhan quotes. Disable only
# if your network can't reach DhanHQ's instrument-list host.
ENABLE_DHAN_INSTRUMENT_LOOKUP=true
# Source historical candles (indicators, scalping screener, sector movers) from
# DhanHQ. Disabling this leaves no live historical data source; symbols without
# real history are excluded rather than assigned synthetic candles.
ENABLE_DHAN_HISTORICAL_DATA=true
# Source current quotes (sector movers' gainers/losers scan) from DhanHQ. Disabling
# this leaves no live-quote source at all.
ENABLE_DHAN_QUOTES=true
# Where each symbol's previous daily close is cached between restarts — used to
# compute correct change% when markets are closed (DhanHQ's own net_change field
# is unreliable while closed).
DHAN_PREVIOUS_CLOSE_CACHE_FILE=.dhan_previous_close_cache.json
# -----------------------------------------
# -----------------------------------------

# -----------------------------------------
# Observability - Langfuse (optional)
# Cloud: https://cloud.langfuse.com | Self-host: set LANGFUSE_HOST to your deployment URL
# -----------------------------------------
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=paper

# Database - PostgreSQL (FREE cloud options)
# 
# Option 1: Neon (RECOMMENDED - 0.5GB free)
#   https://neon.tech → Create project → Copy connection string
#
# Option 2: Supabase (500MB free)
#   https://supabase.com → New project → Settings > Database > Connection string
#
# Option 3: Railway (500MB free trial)
#   https://railway.app → New project → Add PostgreSQL
# -----------------------------------------
DATABASE_URL=postgresql://user:password@your-db-host.neon.tech/trading_agent?sslmode=require

# Trading Configuration
TRADING_MODE=paper  # paper | live
MAX_DAILY_TRADES=50
MAX_POSITION_SIZE=100000
DAILY_LOSS_LIMIT=10000
# Maximum number of open positions at once, across all symbols.
MAX_CONCURRENT_POSITIONS=5
# Maximum total capital deployed across all open positions, as a percent of the
# account (distinct from MAX_TOTAL_RISK, which bounds risk-at-stake, not exposure).
MAX_TOTAL_EXPOSURE_PCT=50.0
# TESTING ONLY: bypass the weekday/trading-hours check so cycles run regardless of
# when it actually is. Real market data (Dhan REST last-known quotes, historical
# OHLCV) already works outside market hours, so this is the only thing standing
# between a closed market and a full end-to-end pipeline test. Loudly logged
# whenever active — never enable for a session with real capital or live intent.
FORCE_TRADING_WINDOW=false
# TESTING ONLY: provide daily mock OHLCV for indicators/signals when Dhan is disabled.
# Honored only by the safe forced/local-paper configuration described above.
ENABLE_SYNTHETIC_HISTORY=false

# ===========================================
# Free Tier Configuration (NEW)
# ===========================================
# Market data source: DhanHQ only (requires a Dhan account). Production paper
# operation should be stopped and investigated if the dashboard reports a
# simulated source rather than DhanHQ.
MARKET_DATA_SOURCE=dhan

# Execution mode: local_paper (free), shadow (mirror live, send nothing), dhan_paper
# (simulate against Dhan-shaped data/mechanics only -- NEVER reaches a real broker
# route, regardless of ALLOW_LIVE_ORDERS or credentials -- there is no verified Dhan
# sandbox endpoint), or live (the only mode that can ever place a real order).
EXECUTION_MODE=local_paper
# Master safety gate: real broker orders are ONLY ever sent when this is true AND
# EXECUTION_MODE=live AND TRADING_MODE=live. Any other combination -- including this
# set to true while TRADING_MODE=paper -- now fails startup instead of silently
# running (see src/config/settings.py validate_configuration, C-2/M-5).
ALLOW_LIVE_ORDERS=false
LONG_ONLY=true

# Enable AI-powered news sentiment analysis
ENABLE_NEWS_ANALYSIS=true

# Close the learn-from-losses loop: classify closed trades into lessons and mark injected
# lessons as helpful/not. Adds an LLM call per losing trade; set false to skip.
ENABLE_LEARNING=true

# Starting balance for local paper trading (INR)
PAPER_WALLET_BALANCE=1000000

# Paper trading costs (so paper P&L is net of realistic costs, not fill-at-screen-price).
# Configurable approximations of an NSE discount-broker cost stack; set to 0 for ideal fills.
PAPER_SLIPPAGE_BPS=2.0       # adverse slippage on fills (2 = 0.02%)
PAPER_BROKERAGE_BPS=3.0      # brokerage as bps of notional
PAPER_BROKERAGE_MAX=20.0     # per-order brokerage cap in INR (0 = uncapped)
PAPER_STATUTORY_BPS=5.0      # combined STT + exchange + SEBI + stamp, as bps
PAPER_GST_PCT=18.0           # GST as a percent of brokerage

# Data ingestion / efficiency
# Compute indicators on settled bars only (drop the still-forming bar on every timeframe) to
# avoid intra-bar repainting / look-ahead. Recommended true.
SIGNALS_EXCLUDE_FORMING_BAR=true
# Skip NEW entries when the freshest quote is older than this many seconds (0 = disabled).
# Exits still run on the last known price. 0 is only permitted when
# ENABLE_DHAN_QUOTES=false (a declared simulation profile with no live quote feed at
# all); with ENABLE_DHAN_QUOTES=true (the default above), 0 now fails startup (H-10) --
# use a conservative positive value instead.
MAX_QUOTE_STALENESS_SECONDS=60
# Comma-separated candle timeframes signals are generated on (any of 15m,30m,1h,4h,1d).
# Each is fetched/scored independently and every signal is tagged with its timeframe.
SIGNAL_TIMEFRAMES=15m,30m,1h,4h
# Send every generated strategy signal to the LLM graph. This can consume substantially
# more tokens; the FinOps daily budget remains the hard spend boundary.
LLM_REVIEW_ALL_SIGNALS=false
# All symbols get multi-timeframe strategy signals and local ML scoring. Retain the best
# sector-diverse symbols after ranking by estimated probability and expected R.
MAX_ACTIVE_STOCKS=15
# Only this many locally ranked symbols receive Groq/news/agent review.
LLM_REVIEW_MAX_SYMBOLS=5
# Avoid over-concentrating the shortlist in a single sector.
UNIVERSE_MAX_PER_SECTOR=2
# Keep the agent prompt focused when several strategies trigger for one symbol.
MAX_SIGNALS_PER_SYMBOL=2
# Investment reviews are intentionally paced to stay within Groq limits.
TRADING_CYCLE_SECONDS=120

# NVIDIA quantitative-signal-discovery-agent architecture adapted to Groq + Dhan.
# Set AUTO_RUN=true for scheduled research; accepted formulas are scored every live cycle.
SIGNAL_DISCOVERY_ENABLED=false
SIGNAL_DISCOVERY_OUTPUT_DIR=data/discovered_signals
SIGNAL_DISCOVERY_TIMEFRAMES=15m,30m,1h,4h
SIGNAL_DISCOVERY_AUTO_RUN=false
SIGNAL_DISCOVERY_REFRESH_HOURS=24
SIGNAL_DISCOVERY_REQUEST=momentum, mean-reversion, breakout, volatility, and volume-price alpha signals
SIGNAL_DISCOVERY_NUM_SIGNALS=3
SIGNAL_DISCOVERY_MAX_ITERATIONS=3
SIGNAL_DISCOVERY_FORWARD_PERIODS=5
SIGNAL_DISCOVERY_IC_THRESHOLD=0.015
SIGNAL_DISCOVERY_P_VALUE_THRESHOLD=0.05
SIGNAL_DISCOVERY_MIN_PERIODS=30
SIGNAL_DISCOVERY_MIN_CROSS_SECTION=8
SIGNAL_DISCOVERY_MAX_PROBABILITY_TILT=0.08

# Fixed %-based stop-loss/take-profit for mean_reversion signals (buy low, sell high
# for a small, repeatable edge rather than chasing a big directional move).
MEAN_REVERSION_STOP_LOSS_PCT=1.2
MEAN_REVERSION_TARGET_PCT=2.5

# ===========================================
# Telegram Notifications (Optional)
# ===========================================
# Get bot token: Talk to @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get chat ID: Talk to @userinfobot on Telegram
# TELEGRAM_CHAT_ID=your_chat_id_here

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=true

# ===========================================
# Web UI (Optional; terminal dashboard works fine without it)
# ===========================================
# Serve a live web dashboard (FastAPI+WebSocket) alongside terminal log output.
# Requires `uv sync --extra web`. Default off.
ENABLE_WEB_UI=false
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8000
# Comma-separated origins allowed to open the web UI WebSocket (Next.js dev server)
WEB_UI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Dashboard login (REQUIRED whenever ENABLE_WEB_UI=true -- the app fails closed at
# startup without these; the dashboard exposes wallet balance, positions, and trading
# activity and must never run unauthenticated). Generate the hash and secret with:
#   uv run python scripts/set_dashboard_password.py
WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD_HASH=pbkdf2_sha256$600000$...$...
# WEB_UI_SESSION_SECRET=
WEB_UI_SESSION_TTL_MINUTES=720
# Set true once the dashboard is served over HTTPS (e.g. behind an Nginx/Let's
# Encrypt reverse proxy) -- false only makes sense for plain-HTTP/loopback access.
WEB_UI_COOKIE_SECURE=false
WEB_UI_LOGIN_MAX_ATTEMPTS=5
WEB_UI_LOGIN_LOCKOUT_MINUTES=15
# Optional: override the built-in NIFTY50+midcap discovery universe with your own
# symbol list. CSV must have a 'symbol' column; falls back to the built-in list if
# unset, missing, or malformed. Feeds the trading-signal loop, sector movers, and the
# scalping screener alike.
# STOCK_UNIVERSE_CSV_PATH=C:\path\to\symbols.csv

# Scan the full discovery universe for sector-wise top gainers/losers,
# on its own timer separate from the trading-signal loop.
ENABLE_SECTOR_MOVERS=true
SECTOR_MOVERS_REFRESH_SECONDS=180

# Scan the discovery universe for symbols that oscillate multiple times a day
# (zigzag swing count), separate from the trading-signal loop. A full scan fetches
# 1-3 timeframes of candles per symbol, so the refresh interval should scale with the
# size of your universe (default 69 symbols; a 200+ symbol CSV universe can take
# 30-60+ minutes per scan — raise this well above that so scans don't overlap).
ENABLE_SCALPING_SCREENER=true
SCALPING_SCREENER_REFRESH_SECONDS=1800
# Minimum move, as a % of the symbol's own price, to count as one swing (price-tier
# aware — e.g. a ₹2000 stock and a ₹50 stock both need a 0.5% move, not a flat ₹ amount).
SCALPING_SWING_THRESHOLD_PCT=0.5
# How many recent trading days the scalping screener averages its swing count over.
SCALPING_SCREENER_LOOKBACK_DAYS=7

# ===========================================
# FinOps - LLM cost tracking & budgets (Optional)
# ===========================================
# Track Groq token usage + paid-tier-equivalent cost, and alert on budget breaches.
FINOPS_ENABLED=true

# Daily caps (per IST day, across all agents). 0 = unlimited (free-tier default).
# When a hard cap is hit, the loop pauses NEW agent cycles (exits still run).
DAILY_TOKEN_BUDGET=0
DAILY_COST_BUDGET_USD=0.0

# Soft-alert threshold as a fraction of a budget (0.8 = warn at 80%).
FINOPS_BUDGET_SOFT_PCT=0.8

# ===========================================
# Profit-target goal engine (Optional)
# ===========================================
# Monthly target as a fraction of capital (0.05 = 5%/mo) and/or an INR amount.
# The larger of the two wins. 0/0 = disabled. The engine is advisory only: it never
# changes position sizing or relaxes risk limits — if a target needs more risk than
# allowed it is flagged infeasible and you are told to LOWER the target.
MONTHLY_PROFIT_TARGET_PCT=0.0
MONTHLY_PROFIT_TARGET_AMOUNT=0.0

# Assumptions used to derive the required win-rate / trade-frequency and pace.
TRADING_DAYS_PER_MONTH=21
EXPECTED_TRADES_PER_DAY=5
GOAL_ASSUMED_WIN_RATE=0.5
GOAL_REWARD_RISK_RATIO=1.5
GOAL_OFF_PACE_TOLERANCE=0.2
